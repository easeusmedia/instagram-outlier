APIFY_TOKEN=paste_your_apify_token_here
PORT=3000

# Optional: point at a hosted Turso database (needed on Render/Vercel, since
# neither gives you a persistent local disk). Leave both blank for local dev —
# the app falls back to a SQLite file at data/store.db automatically.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: gate the app behind "Sign in with Google". Leave all three blank
# for local dev (no login screen at all). Set them on a public deployment so
# random visitors can't burn your Apify credits.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
# Random string used to sign session cookies. If unset, a new one is
# generated on every boot, which logs everyone out on each deploy/restart.
SESSION_SECRET=
