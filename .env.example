APIFY_TOKEN=paste_your_apify_token_here
PORT=3000

# Required: Postgres connection string (e.g. from neon.tech's free tier).
# Same variable for local dev and production — Neon works fine for both.
DATABASE_URL=

# Optional: seeds one admin account on boot (no-ops if either is unset, or
# the account already exists). Set these once, locally and on Render — never
# commit real credentials into source.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: enables semantic search over saved scripts (pgvector). Without
# this, scripts just never get an embedding and /api/search returns a clear
# "not configured" error instead of failing oddly.
OPENAI_API_KEY=

# Optional: also allow "Sign in with Google" alongside email/password
# accounts. Leave all three blank to only offer email/password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
# Random string used to sign session cookies. If unset, a new one is
# generated on every boot, which logs everyone out on each deploy/restart.
SESSION_SECRET=
